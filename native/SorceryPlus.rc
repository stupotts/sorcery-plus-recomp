#include "resource.h"

IDI_SORCERY_PLUS ICON "sorcerer.ico"
IDB_ABOUT_ART BITMAP "about-art.bmp"
IDD_ABOUT DIALOGEX 0, 0, 230, 273
STYLE 0x80c80840 // WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_CENTER | DS_SETFONT
CAPTION "About Sorcery+"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_ABOUT_ART, "Static", 0x5000000d, 8, 8, 214, 207
    CTEXT "", IDC_ABOUT_VERSION, 8, 219, 214, 11
    CTEXT "Recompiled for Windows from the original Z80 code.", IDC_ABOUT_DESCRIPTION, 8, 232, 214, 11
    CTEXT "Program by StuPot", IDC_ABOUT_CREDIT, 8, 244, 214, 11
    DEFPUSHBUTTON "OK", 1, 91, 257, 48, 13
END

1 VERSIONINFO
FILEVERSION SORCERY_VERSION_NUMBERS
PRODUCTVERSION SORCERY_VERSION_NUMBERS
FILEOS 0x00040004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Sorcery+ Multilingual Edition"
            VALUE "FileVersion", SORCERY_VERSION_TEXT
            VALUE "ProductName", "Sorcery+ Multilingual Edition"
            VALUE "ProductVersion", SORCERY_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
