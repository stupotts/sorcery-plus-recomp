{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Sorcery+",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Build.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build and run Sorcery+",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Build.ps1", "-Launch"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$gcc"
    }
  ]
}
